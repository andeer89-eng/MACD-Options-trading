# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# FIREBASE / ALPACA API ACCESS
# Use the Firebase project ID shown in firebase-applet-config.json.
FIREBASE_PROJECT_ID="gen-lang-client-0003725602"
# Server-only service account JSON; keep this secret out of Git and all VITE_* variables.
FIREBASE_SERVICE_ACCOUNT_JSON=""
# Production defaults to required. Set false only for local/dev environments without Firestore.
EXECUTION_LEDGER_REQUIRED="false"
# Background broker reconciliation interval (milliseconds); minimum 30000, default 60000.
EXECUTION_RECONCILIATION_INTERVAL_MS="60000"
# Distributed Firestore worker lease duration in milliseconds (minimum 120000).
EXECUTION_RECONCILIATION_LEASE_MS="240000"
# Dedicated worker credential for read-only watchlist signal evaluation.
# Keep server-side only; never expose through VITE_* or client bundles.
# The endpoint is POST /api/internal/watchlist/evaluate.
WATCHLIST_EVALUATION_WORKER_TOKEN=""

# Dedicated worker credential for the separate state-transition trigger endpoint.
WATCHLIST_TRIGGER_WORKER_TOKEN=""

# Comma-separated Firebase Authentication UIDs allowed to control the shared Alpaca Paper account.
# Find the owner UID in Firebase Console > Authentication > Users. Do not use email addresses here.
ALPACA_ALLOWED_UIDS=""

# ALPACA PAPER TRADING (Server-side only — strictly enforces Paper URL)
# Configure these in server secrets / .env to connect Paper execution.
APCA_API_KEY_ID="MY_ALPACA_PAPER_API_KEY_ID"
APCA_API_SECRET_KEY="MY_ALPACA_PAPER_SECRET_KEY"
APCA_API_BASE_URL="https://paper-api.alpaca.markets"
APCA_DATA_BASE_URL="https://data.alpaca.markets"
